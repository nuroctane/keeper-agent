{
  "name": "keeper-agent-desktop",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "test": "playwright test",
    "format": "prettier --write src tests *.json *.ts *.js src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src tests *.json *.ts *.js src-tauri/*.json src-tauri/capabilities/*.json",
    "test:web": "npm run build && playwright test --config playwright.web.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
