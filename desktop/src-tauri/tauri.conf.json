{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keeper Agent",
  "version": "0.3.2",
  "identifier": "dev.nuroctane.keeper-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keeper Agent",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#121416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Your vault. Your agents. Your rules.",
    "category": "DeveloperTool",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
